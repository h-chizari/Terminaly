#!/usr/bin/env python3
"""tls: High-speed modern tree and tabular directory listing utility (eza equivalent)."""

import argparse
import os
import re
import stat
import sys
import time
import shutil
from pathlib import Path
from typing import List, Tuple, Dict, Any, Optional

# Ensure core is in path
sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
from core.theme import get_active_theme

def format_size(size_bytes: int) -> str:
    if size_bytes < 1024:
        return f"{size_bytes}B"
    elif size_bytes < 1024 * 1024:
        return f"{size_bytes / 1024:.1f}K"
    elif size_bytes < 1024 * 1024 * 1024:
        return f"{size_bytes / (1024 * 1024):.1f}M"
    else:
        return f"{size_bytes / (1024 * 1024 * 1024):.1f}G"

def format_perms(mode: int) -> str:
    is_dir = "d" if stat.S_ISDIR(mode) else ("l" if stat.S_ISLNK(mode) else "-")
    perms = [
        "r" if mode & stat.S_IRUSR else "-",
        "w" if mode & stat.S_IWUSR else "-",
        "x" if mode & stat.S_IXUSR else "-",
        "r" if mode & stat.S_IRGRP else "-",
        "w" if mode & stat.S_IWGRP else "-",
        "x" if mode & stat.S_IXGRP else "-",
        "r" if mode & stat.S_IROTH else "-",
        "w" if mode & stat.S_IWOTH else "-",
        "x" if mode & stat.S_IXOTH else "-",
    ]
    return f"{is_dir}{''.join(perms)}"

def format_mtime(mtime: float) -> str:
    now = time.time()
    if abs(now - mtime) > 180 * 86400:
        return time.strftime("%b %d  %Y", time.localtime(mtime))
    return time.strftime("%b %d %H:%M", time.localtime(mtime))

def get_dir_item_count(path: Path) -> str:
    try:
        count = sum(1 for e in path.iterdir() if not e.name.startswith("."))
        return f"{count} items" if count != 1 else "1 item"
    except Exception:
        return "-"

def get_file_icon_and_color(path: Path, st_mode: int, ansi: Dict[str, str]) -> Tuple[str, str]:
    b = "\033[1m"
    p = ansi.get("primary", "\033[36m")
    s = ansi.get("secondary", "\033[34m")
    suc = ansi.get("success", "\033[32m")
    warn = ansi.get("warning", "\033[33m")
    dang = ansi.get("danger", "\033[31m")
    acc = ansi.get("accent", "\033[35m")
    rst = "\033[0m"

    if stat.S_ISDIR(st_mode):
        return "📁", f"{b}{p}"
    elif stat.S_ISLNK(st_mode):
        return "🔗", f"{acc}"
    elif st_mode & stat.S_IXUSR:
        return "⚡", f"{b}{suc}"

    ext = path.suffix.lower()
    if ext in (".mp4", ".mov", ".mkv", ".avi", ".webm", ".flv", ".m4v"):
        return "🎬", f"{acc}"
    elif ext in (".jpg", ".jpeg", ".png", ".gif", ".webp", ".heic", ".svg", ".bmp", ".ico", ".tiff"):
        return "🖼️ ", f"{warn}"
    elif ext in (".mp3", ".wav", ".flac", ".m4a", ".aac", ".ogg"):
        return "🎵", f"{warn}"
    elif ext in (".zip", ".tar", ".gz", ".7z", ".pkg", ".dmg", ".rar", ".bz2", ".xz", ".tgz"):
        return "📦", f"{dang}"
    elif ext in (".py", ".sh", ".zsh", ".bash", ".js", ".ts", ".go", ".rs", ".c", ".cpp", ".swift", ".html", ".css", ".jsx", ".tsx"):
        return "💻", f"{suc}"
    elif ext in (".json", ".yaml", ".yml", ".toml", ".xml", ".ini", ".conf", ".config", ".plist"):
        return "⚙️ ", f"{p}"
    elif ext in (".md", ".txt", ".rtf", ".pdf", ".docx", ".doc", ".xlsx", ".pptx", ".csv", ".tsv"):
        return "📄", f"{rst}"
    return "📄", f"{rst}"

def get_git_status_map(target_dir: str) -> Dict[str, str]:
    status_map = {}
    try:
        import subprocess
        out = subprocess.check_output(
            ["git", "-C", target_dir, "status", "--porcelain"], text=True, stderr=subprocess.DEVNULL
        )
        for line in out.splitlines():
            if len(line) >= 4:
                st = line[:2].strip()
                file_rel = line[3:].strip()
                status_map[file_rel] = st
    except Exception:
        pass
    return status_map

def print_clean_tabular(entries: List[Path], git_map: Dict[str, str], ansi: Dict[str, str], sort_by: str = "default", reverse: bool = False):
    term_width = shutil.get_terminal_size((80, 24)).columns
    b = "\033[1m"
    dim = "\033[2m"
    rst = "\033[0m"
    p = ansi.get("primary", "\033[36m")
    suc = ansi.get("success", "\033[32m")
    warn = ansi.get("warning", "\033[33m")
    dang = ansi.get("danger", "\033[31m")

    dirs = [e for e in entries if e.is_dir()]
    files = [e for e in entries if not e.is_dir()]

    # Apply sorting
    if sort_by == "time":
        dirs.sort(key=lambda x: x.lstat().st_mtime, reverse=not reverse)
        files.sort(key=lambda x: x.lstat().st_mtime, reverse=not reverse)
    elif sort_by == "size":
        dirs.sort(key=lambda x: x.name.lower(), reverse=reverse)
        files.sort(key=lambda x: x.lstat().st_size, reverse=not reverse)
    else:
        dirs.sort(key=lambda x: x.name.lower(), reverse=reverse)
        files.sort(key=lambda x: x.name.lower(), reverse=reverse)

    total_dirs = len(dirs)
    total_files = len(files)
    total_bytes = 0
    for f in files:
        try:
            if not f.is_symlink():
                total_bytes += f.lstat().st_size
        except Exception:
            pass

    show_extended = term_width >= 72
    rule_len = min(term_width, 90)

    # Header
    if show_extended:
        hdr = f"{dim}{b}{'PERMS'.ljust(11)}  {'SIZE / ITEMS'.rjust(12)}  {'MODIFIED'.ljust(12)}  {'NAME'}{rst}"
    else:
        hdr = f"{dim}{b}{'SIZE / ITEMS'.rjust(12)}  {'MODIFIED'.ljust(12)}  {'NAME'}{rst}"

    print(hdr)
    print(f"{dim}{'─' * rule_len}{rst}")

    # Render Folders
    for d in dirs:
        try:
            st = d.lstat()
            sz_str = get_dir_item_count(d)
            mtime_str = format_mtime(st.st_mtime)
            perms_str = format_perms(st.st_mode)

            rel = os.path.relpath(str(d), ".")
            gst = git_map.get(rel, "")
            gst_str = f" {warn}[{gst}]{rst}" if gst else ""

            name_display = f"{d.name}/"
            if d.is_symlink():
                try:
                    name_display += f" -> {os.readlink(d)}"
                except Exception:
                    pass

            if show_extended:
                print(f"{dim}{perms_str}{rst}  {warn}{sz_str.rjust(12)}{rst}  {dim}{mtime_str.ljust(12)}{rst}  📁 {b}{p}{name_display}{rst}{gst_str}")
            else:
                print(f"{warn}{sz_str.rjust(12)}{rst}  {dim}{mtime_str.ljust(12)}{rst}  📁 {b}{p}{name_display}{rst}{gst_str}")
        except Exception:
            pass

    # Divider between folders and files
    if dirs and files:
        print(f"{dim}{'─' * rule_len}{rst}")

    # Render Files
    for f in files:
        try:
            st = f.lstat()
            sz_str = format_size(st.st_size)
            mtime_str = format_mtime(st.st_mtime)
            perms_str = format_perms(st.st_mode)
            icon, color = get_file_icon_and_color(f, st.st_mode, ansi)

            rel = os.path.relpath(str(f), ".")
            gst = git_map.get(rel, "")
            gst_str = f" {warn}[{gst}]{rst}" if gst else ""

            name_display = f.name
            if f.is_symlink():
                try:
                    name_display += f" -> {os.readlink(f)}"
                except Exception:
                    pass

            # Normalize icon space
            icon_prefix = f"{icon} " if not icon.endswith(" ") else icon

            if show_extended:
                print(f"{dim}{perms_str}{rst}  {suc}{sz_str.rjust(12)}{rst}  {dim}{mtime_str.ljust(12)}{rst}  {icon_prefix}{color}{name_display}{rst}{gst_str}")
            else:
                print(f"{suc}{sz_str.rjust(12)}{rst}  {dim}{mtime_str.ljust(12)}{rst}  {icon_prefix}{color}{name_display}{rst}{gst_str}")
        except Exception:
            pass

    print(f"\n  {dim}Total: {total_dirs} directories, {total_files} files ({format_size(total_bytes).strip()}){rst}\n")

def print_tree(dir_path: Path, prefix: str = "", level: int = 0, max_depth: int = 3, show_hidden: bool = False, ansi: Dict[str, str] = None):
    if level >= max_depth:
        return
    try:
        entries = sorted(list(dir_path.iterdir()), key=lambda x: (not x.is_dir(), x.name.lower()))
    except Exception:
        return

    if not show_hidden:
        entries = [e for e in entries if not e.name.startswith(".")]

    total = len(entries)
    dim = "\033[2m"
    rst = "\033[0m"

    for idx, e in enumerate(entries):
        is_last = (idx == total - 1)
        connector = "└── " if is_last else "├── "
        child_prefix = "    " if is_last else "│   "

        try:
            st = e.lstat()
            icon, color = get_file_icon_and_color(e, st.st_mode, ansi or {})
            name = e.name + ("/" if e.is_dir() else "")
            sz = f" {dim}({format_size(st.st_size).strip()}){rst}" if not e.is_dir() else ""
            icon_prefix = f"{icon} " if not icon.endswith(" ") else icon
            print(f"{prefix}{connector}{icon_prefix}{color}{name}{rst}{sz}")

            if e.is_dir() and not e.is_symlink():
                print_tree(e, prefix + child_prefix, level + 1, max_depth, show_hidden, ansi)
        except Exception:
            pass

def main():
    parser = argparse.ArgumentParser(description="tls: Modern tabular directory and tree listing", add_help=False)
    parser.add_argument("--help", action="help", help="Show this help message and exit")
    parser.add_argument("path", nargs="?", default=".", help="Target directory or file")
    parser.add_argument("-l", "--long", action="store_true", help="Detailed tabular listing")
    parser.add_argument("-a", "--all", action="store_true", help="Include hidden entries")
    parser.add_argument("-A", "--almost-all", action="store_true", help="Include hidden entries except . and ..")
    parser.add_argument("-t", "--time", action="store_true", help="Sort by modification time (newest first)")
    parser.add_argument("-S", "--size", action="store_true", help="Sort by file size (largest first)")
    parser.add_argument("-r", "--reverse", action="store_true", help="Reverse sort order")
    parser.add_argument("-1", action="store_true", dest="one", help="One entry per line")
    parser.add_argument("-T", "--tree", action="store_true", dest="tree", help="Display tree structure")
    parser.add_argument("-d", "--depth", type=int, default=3, help="Max depth for tree view")
    parser.add_argument("-h", action="store_true", dest="human", help="Human readable sizes (enabled by default)")

    args, unknown = parser.parse_known_args()

    # Piping / Non-TTY mode: output plain names for Unix script compatibility
    if not sys.stdout.isatty() and not args.tree:
        target = Path(args.path).resolve()
        if target.is_file():
            print(target.name)
            return
        try:
            entries = sorted(list(target.iterdir()), key=lambda x: x.name.lower())
            if not (args.all or args.almost_all):
                entries = [e for e in entries if not e.name.startswith(".")]
            for e in entries:
                print(e.name)
        except Exception as e:
            print(f"Error: {e}", file=sys.stderr)
            sys.exit(1)
        return

    theme = get_active_theme()
    ansi = theme.get("ansi", {})
    b = "\033[1m"
    p = ansi.get("primary", "\033[36m")
    rst = "\033[0m"

    target = Path(args.path).resolve()
    if not target.exists():
        dang = ansi.get("danger", "\033[31m")
        print(f"{dang}Error: Path '{args.path}' does not exist.{rst}", file=sys.stderr)
        sys.exit(1)

    # Single file target
    if target.is_file():
        git_map = get_git_status_map(str(target.parent))
        print_clean_tabular([target], git_map, ansi)
        return

    # Tree view mode
    if args.tree:
        print(f"{b}{p}📁 {target.name}/{rst}")
        print_tree(target, max_depth=args.depth, show_hidden=(args.all or args.almost_all), ansi=ansi)
        return

    try:
        entries = list(target.iterdir())
        if not (args.all or args.almost_all):
            entries = [e for e in entries if not e.name.startswith(".")]

        # Determine sort method
        sort_by = "time" if args.time else ("size" if args.size else "default")

        # Single-column mode
        if args.one:
            if sort_by == "time":
                entries.sort(key=lambda x: x.lstat().st_mtime, reverse=not args.reverse)
            elif sort_by == "size":
                entries.sort(key=lambda x: x.lstat().st_size, reverse=not args.reverse)
            else:
                entries.sort(key=lambda x: (not x.is_dir(), x.name.lower()), reverse=args.reverse)

            for e in entries:
                st = e.lstat()
                icon, color = get_file_icon_and_color(e, st.st_mode, ansi)
                name = e.name + ("/" if e.is_dir() else "")
                icon_prefix = f"{icon} " if not icon.endswith(" ") else icon
                print(f"{icon_prefix}{color}{name}{rst}")
            return

        # Modern Clean Tabular listing (default for tls / ls)
        git_map = get_git_status_map(str(target))
        print_clean_tabular(entries, git_map, ansi, sort_by=sort_by, reverse=args.reverse)

    except Exception as e:
        dang = ansi.get("danger", "\033[31m")
        print(f"{dang}Error: {e}{rst}", file=sys.stderr)
        sys.exit(1)

if __name__ == "__main__":
    main()
